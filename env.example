# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==================== WEBER UHRENSERVICE CONFIGURATION ====================
# IMGBB_API_KEY: Secure server-side API key for free image hosting via ImgBB.
# Obtain your free API key at: https://api.imgbb.com/
# NEVER include this in public frontend JavaScript or commit your real key to GitHub.
# Place this key in your server environment variables or hosting secret dashboard.
IMGBB_API_KEY="YOUR_IMGBB_FREE_API_KEY_HERE"

# ADMIN_PASSWORD: Initial password for the Weber Uhrenservice Administrator account.
# Default is "admin123" for local testing. In production, set a strong secret password here.
ADMIN_PASSWORD="YOUR_SECURE_ADMIN_PASSWORD"

